{
  "manifest_version": 3,
  "name": "Reels Sayacı",
  "version": "1.0.0",
  "description": "Instagram Reels, YouTube Shorts ve TikTok sayacı. Günlük limit dolunca kapatır ve beyin sağlığını gösterir.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Reels Sayacı",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*"],
      "js": ["brain.js", "store.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
